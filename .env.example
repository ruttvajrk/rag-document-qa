# Copy this file to .env and fill in your own keys. Never commit .env.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-pipeline-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

DATA_DIR=./data
QUERY_LOG_DB=./logs/query_log.db

# Set to false on a public demo so visitors cannot upload files
ALLOW_UPLOADS=true
MAX_UPLOAD_MB=10
